#!/bin/bash
#PBS -P @PROJECT@
#PBS -q @QUEUE@
#PBS -N @JOB_NAME@
#PBS -l ncpus=@NCPUS@
#PBS -l mem=@MEM@
#PBS -l jobfs=@JOBFS@
#PBS -l walltime=@TIME@
#PBS -l storage=@STORAGE@
#PBS -l wd
#PBS -j oe

# Pure MPI, one rank per core (the CPU build has no OpenMP); NTASKS may leave some cores idle to match the box count.
module purge
source @ENV_SCRIPT@ > /dev/null 2>&1

# continue from the newest checkpoint, if there is one (chained jobs)
CHK=$(ls -d chk[0-9]* 2> /dev/null | sort | tail -n 1)
RESTART=${CHK:+restartfile=$CHK}
echo "$(date -Is) $PBS_JOBID start ${RESTART:-from scratch}" >> chain.log

mpirun -np @NTASKS@ --map-by core --bind-to core @COMMAND@ $RESTART >> run.log 2>&1
echo "$(date -Is) $PBS_JOBID exit $?" >> chain.log

# Resubmit (at most @CHAIN@ times) only if every job so far, this one included, ended cleanly ("Simulation ended" once
# per start; a crash breaks the count), this one stopped short of the end time (walltime limit), and it wrote a new checkpoint.
STARTS=$(grep -c " start " chain.log)
ENDED=$(grep -c "Simulation ended at t" run.log)
LAST=$(grep "Simulation ended at t" run.log | tail -n 1)
NEW=$(ls -d chk[0-9]* 2> /dev/null | sort | tail -n 1)
if [ @CHAIN@ -gt 0 ] && [ "$ENDED" -eq "$STARTS" ] && ! echo "$LAST" | grep -q "(100%)" \
	&& [ "$NEW" != "$CHK" ] && [ "$STARTS" -le @CHAIN@ ]; then
	ls -d chk[0-9]* | sort | head -n -2 | xargs -r rm -rf # keep the two newest checkpoints
	qsub job.pbs >> chain.log
fi
