#!/bin/bash
#PBS -P @PROJECT@
#PBS -q @QUEUE@
#PBS -N @JOB_NAME@
#PBS -l ncpus=@NCPUS@
#PBS -l ngpus=@NGPUS@
#PBS -l mem=@MEM@
#PBS -l jobfs=@JOBFS@
#PBS -l walltime=@TIME@
#PBS -l storage=@STORAGE@
#PBS -j oe
#PBS -o @LOG@

# One rank on one GPU. Each `run` line runs one run directory to completion in turn (runs whose run.log already has
# "Finished." are skipped, so a batch cut off by the walltime can be resubmitted as is). device.txt records the GPU.
module purge
source @ENV_SCRIPT@ > /dev/null 2>&1
export OMP_NUM_THREADS=1

run() {
	local dir=$1
	shift
	cd "$dir" || return
	if grep -q '^Finished\.' run.log 2>/dev/null; then
		echo "$(date -Is) skip $dir (finished)"
		return
	fi
	echo "$(date -Is) start $dir"
	nvidia-smi --query-gpu=name,compute_cap,driver_version --format=csv,noheader > device.txt 2>&1
	mpirun -np 1 "$@" > run.log 2>&1
	local status=$?
	echo "$(date -Is) end $dir (exit $status)"
}

@RUNS@
